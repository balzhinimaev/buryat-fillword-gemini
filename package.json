    "@capacitor/push-notifications": "^8.0.1",
    "@capgo/capacitor-updater": "^8.49.7",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.4.0"
